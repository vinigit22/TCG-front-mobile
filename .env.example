# Copie para ".env" e ajuste. As variáveis EXPO_PUBLIC_* entram no app quando o Metro inicia:
# depois de mudar, reinicie o "npx expo start".

# Ausente ou true: o app usa os dados de src/mocks (padrão). false: os services chamam o TCGBackend.
EXPO_PUBLIC_USE_MOCK_API=false

# Endereço do TCGBackend (só é usado com EXPO_PUBLIC_USE_MOCK_API=false):
#   web / simulador iOS: http://localhost:8080
#   emulador Android:    http://10.0.2.2:8080
#   celular físico:      http://<IP da máquina na rede>:8080 (libere a porta 8080 no firewall)
EXPO_PUBLIC_API_URL=http://localhost:8080
